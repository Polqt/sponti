# Supabase Configuration
# Get these from your Supabase project settings > API
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_KEY=your_supabase_anon_key

# Google OAuth Configuration
# Get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_SERVER_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional: Google Auth Secret (only needed for server-side OAuth)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Feature flags
# Keep these off until the new RPCs and metrics are deployed.
FEATURE_RANKED_SEARCH=false
FEATURE_CURSOR_PAGINATION=false
FEATURE_LOCATION_METRICS=false
